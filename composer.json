{
    "name": "sendclipper/sendclipper-php",
    "description": "Official PHP SDK for the SendClipper email API: send mail, manage domains, templates, sandboxes, webhooks, contacts and suppressions.",
    "type": "library",
    "license": "MIT",
    "keywords": ["sendclipper", "email", "transactional-email", "smtp", "webhooks", "sdk"],
    "homepage": "https://sendclipper.com/docs#sdk-php",
    "authors": [
        {"name": "SendClipper", "email": "support@sendclipper.com"}
    ],
    "support": {
        "issues": "https://github.com/sendclipper/sendclipper-php/issues",
        "source": "https://github.com/sendclipper/sendclipper-php",
        "docs": "https://sendclipper.com/docs#sdk-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {"SendClipper\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"SendClipper\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:live": "phpunit --testsuite live",
        "analyse": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true
    }
}
